{
  "schema_version": "1.0.0",
  "_meta": {
    "schema_version": "1.0.0",
    "catalog_version": "2026.07.09-2",
    "description": "Curated open-source model catalog with per-model hardware requirements. Each row is bucketed as 'recommended' / 'possible' / 'insufficient' for the caller's detected hardware. Covers common families (Llama, Qwen, Gemma, Phi, DeepSeek, Mistral) plus longer-tail vendors (Moonshot / Kimi-VL, Cohere Command R / Aya, 01.AI Yi, BigCode StarCoder, NVIDIA Nemotron, AllenAI OLMo). Rows with a 'gguf' block include a Hugging Face pointer so a local llama.cpp-style runtime can download the weights directly.",
    "last_updated": "2026-07-09",
    "catalog_governance": {
      "canonical_source": "This file. Live at https://github.com/Eriador-Admin/eriador-model-catalog (public, MIT). Add / deprecate models via PR against local-models/v1/catalog.json on that repo — schema validation + Hugging Face URL reachability run in CI. Merging to main lands the change on every consumer within one refresh cycle.",
      "consumer_contract": "Consumers fetch this JSON over HTTPS at a stable URL, validate it against local-models/v1/schema.json, and fall back to their own bundled copy if the remote is unreachable or the payload fails validation. See the schema for required per-row fields (model_id, display_name, size_gb, min_ram_gb) and the optional gguf block shape.",
      "weights_track": "Orthogonal to catalog governance. GGUFs are pulled directly from Hugging Face using the gguf.repo_id + gguf.filename references. If an upstream repo is renamed or taken down, deprecate the row here and add a replacement pointing at a different quant maintainer."
    },
    "source": "Ollama library sizes (https://ollama.com/library) as of the update date, cross-checked against vendor Hugging Face repos. RAM sizing follows the '~2x model size' rule for Q4 with generous KV-cache headroom. Non-Ollama rows use Hugging Face GGUF quants published by bartowski / mradermacher / the model vendor.",
    "field_shapes": {
      "model_id": "Stable per-model identifier. For Ollama-registry rows: the pull ref (e.g. 'llama3.1:8b'). For direct-GGUF rows: any stable id — the actual download source is the `gguf` block below.",
      "display_name": "Human label for cards and dropdowns.",
      "family": "Model family (llama, qwen, gemma, phi, deepseek, ...) — used for icons and group headers.",
      "vendor": "Publishing organization.",
      "param_count_b": "Parameter count in billions.",
      "size_gb": "Approx on-disk size for the recommended quantization (Q4_K_M for most rows).",
      "min_ram_gb": "Bare minimum RAM to load — will page heavily below this.",
      "recommended_ram_gb": "Comfortable inference RAM (fits the model + generous KV cache).",
      "min_vram_gb": "0 = CPU-only viable.",
      "recommended_vram_gb": "GPU offload target (all layers).",
      "use_cases": "Any of: chat, code, reasoning, embed, vision.",
      "notes": "Free-form guidance for the recommendation UI.",
      "gguf": "OPTIONAL block. Populated when a row is downloadable by a local llama.cpp-style runtime. Shape: { repo_id: HF org/repo (e.g. 'bartowski/Meta-Llama-3.1-8B-Instruct-GGUF'), filename: exact .gguf file (e.g. 'Meta-Llama-3.1-8B-Instruct-Q4_K_M.gguf'), sha256: hex digest for integrity verification (null until verified), size_bytes: exact byte count (null until measured), quant: 'Q4_K_M' / 'Q5_K_M' / etc (informational) }. Rows without this block are runtime-registry-only (e.g. Ollama pull ref only)."
    },
    "gguf_status": "Many rows carry a gguf pointer but currently ship sha256=null / size_bytes=null. Downloads will succeed but integrity verification is skipped until measured values are backfilled against pinned upstream versions — see scripts/verify-hf-urls.mjs."
  },
